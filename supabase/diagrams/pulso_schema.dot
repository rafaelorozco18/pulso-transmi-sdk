</FONT></TD><TD ALIGN="LEFT" PORT="ingestion_run_id_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">bigint?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ingested_at_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">ingested_at</FONT></TD><TD ALIGN="LEFT" PORT="ingested_at_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">timestamptz</FONT></TD></TR></TABLE>>];
