digraph pulso {
  graph [rankdir=LR, bgcolor="#fcfcfb", pad=0.5, nodesep=0.28, ranksep=1.0, newrank=true,
         fontname="DejaVu Sans", labelloc=t, labeljust=l, fontsize=24, fontcolor="#15171a",
         label=<<B>Esquema pulso · Supabase pulso-transmi</B><BR/><FONT POINT-SIZE="13" COLOR="#7d8187">18 tablas · 5 vistas · 20 llaves foráneas · PK = llave primaria · FK = llave foránea · ? = admite null · ─&lt; uno a muchos · - - - vista lee de</FONT>>];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#8a8f96", penwidth=1.3, arrowsize=0.8, fontname="DejaVu Sans"];
  subgraph cluster_0 {
    label=<<B>Datos de la API</B>>; fontsize=16; fontcolor="#2a78d6"; color="#2a78d6"; style="rounded,dashed"; penwidth=1.2; margin=16;
    stations [label=<<TABLE BORDER="1" COLOR="#2a78d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#e2edfa" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#15171a"><B>stations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="station_id_in" WIDTH="28"><FONT POINT-SIZE="8" COLOR="#2a78d6"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a"><B>station_id</B></FONT></TD><TD ALIGN="LEFT" PORT="station_id_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="station_name_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">station_name</FONT></TD><TD ALIGN="LEFT" PORT="station_name_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="corridor_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">corridor</FONT></TD><TD ALIGN="LEFT" PORT="corridor_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="latitude_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">latitude</FONT></TD><TD ALIGN="LEFT" PORT="latitude_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">numeric(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="longitude_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">longitude</FONT></TD><TD ALIGN="LEFT" PORT="longitude_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">numeric(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="archetype_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">archetype</FONT></TD><TD ALIGN="LEFT" PORT="archetype_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">text?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">created_at</FONT></TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">timestamptz</FONT></TD></TR></TABLE>>];
    calendar_days [label=<<TABLE BORDER="1" COLOR="#2a78d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#e2edfa" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#15171a"><B>calendar_days</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="day_in" WIDTH="28"><FONT POINT-SIZE="8" COLOR="#2a78d6"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a"><B>day</B></FONT></TD><TD ALIGN="LEFT" PORT="day_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="day_type_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">day_type</FONT></TD><TD ALIGN="LEFT" PORT="day_type_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_holiday_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">is_holiday</FONT></TD><TD ALIGN="LEFT" PORT="is_holiday_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="holiday_name_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">holiday_name</FONT></TD><TD ALIGN="LEFT" PORT="holiday_name_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">text?</FONT></TD></TR></TABLE>>];
    observations [label=<<TABLE BORDER="1" COLOR="#2a78d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#e2edfa" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#15171a"><B>observations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="station_id_in" WIDTH="28"><FONT POINT-SIZE="8" COLOR="#2a78d6"><B>PK·FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a"><B>station_id</B></FONT></TD><TD ALIGN="LEFT" PORT="station_id_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observed_at_in" WIDTH="28"><FONT POINT-SIZE="8" COLOR="#2a78d6"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a"><B>observed_at</B></FONT></TD><TD ALIGN="LEFT" PORT="observed_at_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="demand_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">demand</FONT></TD><TD ALIGN="LEFT" PORT="demand_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ingestion_run_id_in" WIDTH="28"><FONT POINT-SIZE="8" COLOR="#2a78d6"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">ingestion_run_id</FONT></TD><TD ALIGN="LEFT" PORT="ingestion_run_id_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">bigint?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ingested_at_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">ingested_at</FONT></TD><TD ALIGN="LEFT" PORT="ingested_at_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at_in" WIDTH="28"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a">updated_at</FONT></TD><TD ALIGN="LEFT" PORT="updated_at_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">timestamptz</FONT></TD></TR></TABLE>>];
