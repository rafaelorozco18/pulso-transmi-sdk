="#2a78d6"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#15171a"><B>revision_id</B></FONT></TD><TD ALIGN="LEFT" PORT="revision_id_out"><FONT POINT-SIZE="9.5" COLOR="#7d8187">bigint</FONT></TD></TR></TABLE>>];
